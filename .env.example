# =============================================================================
# Universal AI Copilot — Environment Configuration
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real credentials.
# =============================================================================

# REQUIRED — Google AI Studio API key.
# Used SERVER-SIDE ONLY to access the Gemini API, which serves Gemma models.
# Obtain one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTIONAL — The Gemma model identifier used for all AI operations.
# Gemma 4 is the core intelligence of the application. This value is the single
# source of truth for the model name; it is never hardcoded in application logic.
# Defaults to gemma-4-26b-a4b-it when left unset. Override only to target another
# Gemma variant. Verify the current documented model ID at:
# https://ai.google.dev/gemma/docs
GEMMA_MODEL=gemma-4-26b-a4b-it

# OPTIONAL — Maximum accepted upload size in megabytes (default: 15).
MAX_UPLOAD_MB=15

# OPTIONAL — Per-request AI timeout in milliseconds (default: 45000).
AI_REQUEST_TIMEOUT_MS=45000
